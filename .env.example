# Hugging Face token, used by the HFInferenceBackend (get one at https://huggingface.co/settings/tokens)
HF_TOKEN=

# Model id served via the HF Inference API (must be a model available on your HF plan)
INFERENCE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Backend selection: hf | local | mock
# If left unset, the app auto-selects: "hf" when HF_TOKEN is set, otherwise "mock".
INFERENCE_BACKEND=

# Only used by the local backend (src/app/inference_engine.py -> LocalTransformersBackend)
LOCAL_BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LORA_ADAPTER_DIR=
# CPU weight precision for the local backend: float32 | bfloat16. Leave
# empty to auto-pick (float32 -- much faster on most CPUs -- when >=8GB is
# free at startup, otherwise bfloat16, which needs about half the memory).
LOCAL_DTYPE=
